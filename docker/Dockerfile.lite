# Slim TFLite image for Render's free tier (512 MB RAM). Build from the repo root:
#   docker build -f docker/Dockerfile.lite -t maize-lite .
#   docker run --rm -p 8000:8000 -e PORT=8000 maize-lite

# ---- stage 1: build the React front end -------------------------------------------------
FROM node:20-slim AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---- stage 2: API + models ---------------------------------------------------------------
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MAIZE_ARTIFACTS=/app/artifacts
WORKDIR /app

COPY requirements/serve-lite.txt requirements/
RUN pip install -r requirements/serve-lite.txt

COPY pyproject.toml ./
COPY src/ src/
RUN pip install --no-deps .

COPY artifacts/release-lite/ artifacts/
COPY --from=web /web/dist static/

RUN useradd -m app && chown -R app /app
USER app

# Render injects $PORT (default 10000); locally pass -e PORT=8000
CMD ["sh", "-c", "uvicorn maize.serving.api:app --host 0.0.0.0 --port ${PORT:-10000}"]
